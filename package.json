{
	"name": "@furbyhaxx/pi-tree-navigator",
	"version": "0.3.0",
	"description": "Agent-callable session tree navigation for Pi: anchor milestones, fold work into branch summaries, recover from context overflow, keep long autonomous sessions within their window.",
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=22.19.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/furbyhaxx/pi-tree-navigator.git"
	},
	"homepage": "https://github.com/furbyhaxx/pi-tree-navigator#readme",
	"bugs": {
		"url": "https://github.com/furbyhaxx/pi-tree-navigator/issues"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"session-tree",
		"branch-summary",
		"agent-memory",
		"context-management"
	],
	"files": [
		"src",
		"scripts/restructure-session.mjs",
		"docs",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run typecheck && bun run lint && bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-agent-core": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/bun": "1.4.3",
		"typebox": "1.3.27",
		"typescript": "7.0.2"
	}
}
